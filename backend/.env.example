# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Chat LLM ---

# Default provider when the UI loads (users pick provider + model from live API catalogs)
# local | google | opencode
CHAT_PROVIDER=google

# Google AI Studio: https://aistudio.google.com/apikey
# Models listed live from https://generativelanguage.googleapis.com/v1beta/models
GOOGLE_API_KEY=your-google-ai-studio-api-key

# OpenCode Zen Go: https://opencode.ai/docs/zen/
# Models listed live from https://opencode.ai/zen/go/v1/models
OPENCODE_API_KEY=your-opencode-zen-api-key
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# --- Embeddings (Google AI Studio recommended) ---

# ollama | google | none
EMBEDDING_PROVIDER=google
EMBEDDING_DIMENSIONS=768
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional local Ollama for embeddings (alternative to Google; requires re-embed if switching).
# OLLAMA_BASE_URL is the only env that changes between local dev and production.
# Same model (nomic-embed-text) on both — vectors stay compatible.
#
# Local dev (ingest, re-embed, and query-time embeddings on your machine):
#   OLLAMA_BASE_URL=http://localhost:11434
#   ollama pull nomic-embed-text
#
# Production (OCI server behind Cloudflare):
#   OLLAMA_BASE_URL=https://ollama.kpargi.eu.org
OLLAMA_BASE_URL=http://localhost:11434

# Optional: show local Ollama in /chat/providers (chat LLM tab). Embeddings use EMBEDDING_PROVIDER.
USE_OLLAMA=false

GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
